{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SeamForge",
  "version": "2.0.0",
  "identifier": "studio.seamforge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SeamForge",
        "width": 1340,
        "height": 840,
        "minWidth": 980,
        "minHeight": 640,
        "backgroundColor": "#121417",
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Aviello Studio",
    "copyright": "Copyright (c) 2026 Aviello Studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
