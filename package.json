{
  "name": "seamforge",
  "version": "2.0.0",
  "private": true,
  "description": "Precision desktop studio for seamless musical audio loops.",
  "author": "NIGATAulxgenii",
  "license": "MIT",
  "homepage": "https://github.com/NIGATAulxgenii/seamforge",
  "repository": {
    "type": "git",
    "url": "https://github.com/NIGATAulxgenii/seamforge.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle",
    "dist:portable": "npm run tauri:build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run typecheck && npm run test && npm run test:rust && npm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
